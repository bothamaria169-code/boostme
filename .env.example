# Copy to .env on the server and fill in. Never commit .env.
APP_URL=https://boostme.swiftfusion.co.za
APP_TZ=Africa/Johannesburg
APP_DEBUG=false

DB_HOST=localhost
DB_NAME=swiftfusionco_boostme
DB_USER=swiftfusionco_booster
DB_PASS=

# SMTP for weekly reports (cPanel → Email Accounts → Connect Devices). Blank MAIL_HOST = PHP mail().
MAIL_HOST=mail.swiftfusion.co.za
MAIL_PORT=465
MAIL_USER=boostme@swiftfusion.co.za
MAIL_PASS=
MAIL_FROM=boostme@swiftfusion.co.za
MAIL_FROM_NAME=BoostMe

# Only needed if cron must be called over the web: cron.php?key=...
CRON_KEY=
